web: cp .env.example .env && touch .env && echo "DB_HOST=${DB_HOST:-127.0.0.1}" >> .env && echo "DB_PORT=${DB_PORT:-3306}" >> .env && echo "DB_DATABASE=${DB_DATABASE}" >> .env && echo "DB_USERNAME=${DB_USERNAME}" >> .env && echo "DB_PASSWORD=${DB_PASSWORD}" >> .env && echo "REDIS_HOST=${REDIS_HOST:-127.0.0.1}" >> .env && echo "REDIS_PORT=${REDIS_PORT:-6379}" >> .env && echo "APP_URL=https://drall.up.railway.app" >> .env && echo "APP_ENV=production" >> .env && echo "APP_DEBUG=false" >> .env && (php artisan key:generate --force --no-interaction || true; php artisan optimize:clear 2>/dev/null; php artisan migrate --force --no-interaction && (php artisan db:seed --force --no-interaction || echo "Seeders may have already run") && (php artisan db:seed --class="Webkul\\Installer\\Database\\Seeders\\Shop\\DatabaseSeeder" --force --no-interaction || echo "Theme seeders may have already run") && touch storage/installed; php artisan config:cache; if command -v faable-php-serve >/dev/null 2>&1; then faable-php-serve public; else php artisan serve --host=0.0.0.0 --port=$PORT; fi)
